# GCP / Vertex AI
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-northeast3
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash

# GitHub
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_ACCESS_TOKEN=your-github-personal-access-token

# KIPRIS Plus (https://plus.kipris.or.kr 에서 발급받은 ServiceKey)
KIPRIS_PLUS_SERVICE_KEY=your-kipris-service-key

# Firestore
FIRESTORE_COLLECTION=ip_sentinel_reports

# 실제 값은 여기(.env)에 넣지 말고 Secret Manager에 등록한 뒤,
# Cloud Run 배포 시 --set-secrets 옵션으로 주입하는 것을 권장합니다.
# 이 .env.example 파일 자체는 실제 키 없이 저장소에 커밋해도 됩니다.
